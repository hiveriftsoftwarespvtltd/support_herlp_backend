# ===============================
# JWT CONFIG
# ===============================
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret
ACCESS_TOKEN_TTL=30d
REFRESH_TOKEN_TTL=7d

# ===============================
# DATABASE (MONGODB ATLAS)
# ===============================
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/support_help?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/support_help?retryWrites=true&w=majority

# ===============================
# ADMIN CREDENTIALS
# ===============================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password

# ===============================
# EMAIL / SMTP SETTINGS
# ===============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
MAIL_FROM="your_email@gmail.com"
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# ===============================
# SERVER
# ===============================
NODE_ENV=development
PORT=9003
ALLOWED_ORIGINS=https://supporthelp.online,http://localhost:3000,http://localhost:5173
